<configuration>

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %X{transactionId} %-5level %class{36}.%M %L - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="com.pictet" level="INFO"/>
    <logger name="org.springframework.data.mongodb.core.MongoTemplate" level="WARN"/>

</configuration>